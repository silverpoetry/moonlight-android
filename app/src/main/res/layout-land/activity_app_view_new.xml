<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_axi_main"
    tools:context=".AppView" >

    <ImageView
        android:scaleType="centerCrop"
        android:layout_width="match_parent"
        android:id="@+id/iv_root_view"
        android:visibility="gone"
        tools:visibility="visible"
        android:contentDescription="@null"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/rv_top_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/appListText"
            tools:text="我的电脑"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:gravity="center"
            android:layout_marginTop="15dp"
            android:layout_marginStart="35dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="15dp"
            android:textSize="20sp"/>

        <TextView
            android:text="@string/app_list_long_press_hint"
            android:layout_marginTop="25dp"
            android:layout_marginEnd="8dp"
            android:textStyle="italic"
            android:textSize="11sp"
            android:ellipsize="end"
            android:singleLine="true"
            android:layout_toEndOf="@+id/appListText"
            android:layout_toStartOf="@id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="10dp"
            android:background="@drawable/ic_game_menu_btn_side_selector"
            android:src="@drawable/ic_axi_menu"
            android:scaleType="centerInside"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/appview_menu_options"
            android:layout_width="36dp"
            android:layout_height="36dp"/>
    </RelativeLayout>


    <FrameLayout
        android:id="@+id/appFragmentContainer"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_below="@+id/rv_top_view"/>



</RelativeLayout>
