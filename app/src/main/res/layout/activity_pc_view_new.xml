<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main"
    tools:ignore="MissingDefaultResource">

    <ImageView
        android:scaleType="centerCrop"
        android:layout_width="match_parent"
        android:id="@+id/iv_root_view"
        android:visibility="gone"
        tools:visibility="visible"
        android:contentDescription="@null"
        android:layout_height="match_parent"/>

    <RelativeLayout
        android:id="@+id/rv_top_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_marginStart="15dp"
            android:layout_marginEnd="5dp"
            android:layout_toStartOf="@id/lv_right"
            android:text="@string/app_label"
            android:textSize="18sp"
            android:id="@+id/tx_label"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="48dp"/>

        <LinearLayout
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="10dp"
            android:id="@+id/lv_right"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="48dp">

            <ImageButton
                android:id="@+id/inputDiagnosticsButton"
                android:background="@drawable/ic_game_menu_btn_side_selector"
                android:src="@drawable/ic_game_controller"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/input_diagnostics_title"
                android:scaleType="centerInside"
                android:padding="3dp"
                android:layout_width="35dp"
                android:layout_height="35dp"/>

            <ImageButton
                android:id="@+id/manuallyAddPc"
                android:background="@drawable/ic_game_menu_btn_side_selector"
                android:src="@drawable/ic_app_add"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/title_add_pc"
                android:padding="2.5dp"
                android:layout_width="35dp"
                android:scaleType="centerInside"
                android:layout_height="35dp"/>

            <ImageButton
                android:id="@+id/helpButton"
                android:background="@drawable/ic_game_menu_btn_side_selector"
                android:src="@drawable/ic_app_about"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/help"
                android:scaleType="centerInside"
                android:padding="3dp"
                android:layout_width="35dp"
                android:layout_height="35dp"/>

            <ImageButton
                android:id="@+id/settingsButton"
                android:background="@drawable/ic_game_menu_btn_side_selector"
                android:src="@drawable/ic_app_setting"
                android:contentDescription="@string/settings_title"
                android:scaleType="centerInside"
                android:layout_width="35dp"
                android:layout_height="35dp"/>

        </LinearLayout>

    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="5dp"
        android:layout_marginBottom="15dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginTop="28dp"
        android:background="@android:color/transparent"
        android:layout_below="@+id/rv_top_view"
        android:layout_alignParentBottom="true">

        <!-- This toggleable empty-state row overlays the fragment host above. -->
        <LinearLayout
            android:id="@+id/no_pc_found_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UselessParent">
            <ProgressBar
                android:id="@+id/pcs_loading"
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:indeterminateDrawable="@drawable/ic_progress_bg"
                android:indeterminate="true"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:gravity="center"
                android:textSize="12sp"
                android:textStyle="italic"
                android:text="@string/searching_pc"/>
        </LinearLayout>

    </RelativeLayout>
</RelativeLayout>
