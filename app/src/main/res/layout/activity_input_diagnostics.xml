<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_axi_main"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/inputDiagnosticsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/inputDiagnosticsBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/accessibility_back"
            android:padding="10dp"
            android:src="@drawable/ic_axi_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/input_diagnostics_title"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/input_diagnostics_subtitle"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/inputDiagnosticsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/refreshInputDevices"
                    style="@style/InputDiagnosticsActionButton"
                    android:layout_marginEnd="6dp"
                    android:text="@string/input_diagnostics_refresh" />

                <Button
                    android:id="@+id/testDeviceVibration"
                    style="@style/InputDiagnosticsActionButton"
                    android:layout_marginStart="6dp"
                    android:text="@string/input_diagnostics_test_device_vibration" />
            </LinearLayout>

            <Button
                android:id="@+id/testControllerVibration"
                style="@style/InputDiagnosticsActionButton"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:enabled="false"
                android:text="@string/input_diagnostics_test_controller_vibration" />

            <TextView
                style="@style/InputDiagnosticsSectionTitle"
                android:text="@string/input_diagnostics_devices" />

            <TextView
                android:id="@+id/inputDiagnosticsDevices"
                style="@style/InputDiagnosticsCard"
                android:text="@string/input_diagnostics_loading" />

            <TextView
                style="@style/InputDiagnosticsSectionTitle"
                android:text="@string/input_diagnostics_live_input" />

            <TextView
                android:id="@+id/inputDiagnosticsEvents"
                style="@style/InputDiagnosticsCard"
                android:minHeight="108dp"
                android:text="@string/input_diagnostics_input_hint" />

            <TextView
                style="@style/InputDiagnosticsSectionTitle"
                android:text="@string/input_diagnostics_sensors" />

            <TextView
                android:id="@+id/inputDiagnosticsSensors"
                style="@style/InputDiagnosticsCard"
                android:text="@string/input_diagnostics_loading" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
