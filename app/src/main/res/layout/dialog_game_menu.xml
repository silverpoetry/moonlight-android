<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="364dp"
    android:layout_height="match_parent"
    android:background="#E6272727"
    tools:ignore="ButtonStyle,Overdraw">

    <LinearLayout
        android:layout_alignParentEnd="true"
        android:orientation="vertical"
        android:layout_width="64dp"
        android:id="@+id/right_view"
        android:gravity="center"
        android:background="#99000000"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_height="wrap_content">
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableTop="@drawable/ic_menu_grid"
                android:gravity="center"
                android:background="@drawable/ic_game_menu_btn_side_selector"
                android:padding="4dp"
                android:text="@string/game_menu_tab_actions"
                android:id="@+id/btn_soft_function"
                android:textSize="11sp" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_height="wrap_content">
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableTop="@drawable/ic_axi_keyboard"
                android:gravity="center"
                android:background="@drawable/ic_game_menu_btn_side_selector"
                android:padding="4dp"
                android:text="@string/game_menu_tab_keyboard"
                android:id="@+id/btn_soft_keyboard"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_height="wrap_content">
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableTop="@drawable/ic_axi_desktop"
                android:gravity="center"
                android:background="@drawable/ic_game_menu_btn_side_selector"
                android:padding="4dp"
                android:text="@string/game_menu_tab_desktop"
                android:id="@+id/btn_desktop"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_height="wrap_content">
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableTop="@drawable/ic_axi_window"
                android:gravity="center"
                android:background="@drawable/ic_game_menu_btn_side_selector"
                android:padding="4dp"
                android:text="@string/game_menu_tab_windows"
                android:id="@+id/btn_window"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:id="@+id/leftView"
        android:paddingBottom="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:scrollbars="none"
        android:layout_toStartOf="@+id/right_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/game_menu_title"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:id="@+id/tx_title_name"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:layout_toEndOf="@+id/tx_title_name"
                android:layout_toStartOf="@+id/btn_customize_actions"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/game_menu_session_only"
                android:textStyle="italic"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/btn_customize_actions"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="5dp"
                android:layout_toStartOf="@+id/textClock"
                android:background="@drawable/ic_game_menu_btn_transparent"
                android:contentDescription="@string/game_menu_customize"
                android:padding="8dp"
                android:src="@drawable/ic_axi_edit" />

            <TextClock
                android:id="@+id/textClock"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/tx_title_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE hh:mm"
                android:format24Hour="EEEE HH:mm" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tx_title_battery"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="100%"
                android:gravity="center"
                app:drawableStartCompat="@drawable/ic_axi_game_pad_battery"
                android:layout_marginStart="4dp"
                android:textColor="@android:color/white"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/game_menu_action_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_margin="5dp"
            android:orientation="horizontal">

            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/ic_game_menu_btn_selector"
                android:drawablePadding="4dp"
                android:drawableTop="@drawable/ic_axi_unlink"
                android:gravity="center"
                android:padding="4dp"
                android:id="@+id/btn_unlink"
                android:text="@string/game_menu_action_disconnect"
                android:textSize="11sp" />

            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/ic_game_menu_btn_selector"
                android:drawablePadding="4dp"
                android:drawableTop="@drawable/ic_axi_exit"
                android:gravity="center"
                android:padding="4dp"
                android:id="@+id/btn_exit"
                android:text="@string/game_menu_action_quit_stream"
                android:textSize="11sp" />

            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/ic_game_menu_btn_selector"
                android:drawablePadding="4dp"
                android:drawableTop="@drawable/ic_axi_screen"
                android:gravity="center"
                android:padding="4dp"
                android:id="@+id/btn_swicth_screen"
                android:text="@string/game_menu_action_rotate"
                android:textSize="11sp" />

            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/ic_game_menu_btn_selector"
                android:drawablePadding="4dp"
                android:drawableTop="@drawable/ic_axi_performance"
                android:gravity="center"
                android:padding="4dp"
                android:id="@+id/btn_performance"
                android:text="@string/game_menu_action_performance"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_margin="5dp"
            android:orientation="horizontal">

            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/ic_game_menu_btn_selector"
                android:drawablePadding="4dp"
                android:drawableTop="@drawable/ic_axi_game_pad"
                android:gravity="center"
                android:padding="4dp"
                android:id="@+id/btn_game_pad"
                android:text="@string/game_menu_action_virtual_gamepad"
                android:textSize="11sp" />

            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/ic_game_menu_btn_selector"
                android:drawablePadding="4dp"
                android:drawableTop="@drawable/ic_axi_vkeyboard"
                android:gravity="center"
                android:padding="4dp"
                android:id="@+id/btn_v_keyboard"
                android:text="@string/game_menu_action_virtual_buttons"
                android:textSize="11sp" />

            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/ic_game_menu_btn_selector"
                android:drawablePadding="4dp"
                android:drawableTop="@drawable/ic_axi_quick"
                android:gravity="center"
                android:padding="4dp"
                android:text="@string/game_menu_action_full_keyboard"
                android:id="@+id/btn_keyboard"
                android:textSize="11sp" />

            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/ic_game_menu_btn_selector"
                android:drawablePadding="4dp"
                android:drawableTop="@drawable/ic_axi_zoom"
                android:gravity="center"
                android:padding="4dp"
                android:id="@+id/btn_screen_move"
                android:text="@string/game_menu_action_screen_zoom"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_margin="5dp"
            android:orientation="horizontal">

            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/ic_game_menu_btn_selector"
                android:drawablePadding="4dp"
                android:drawableTop="@drawable/ic_axi_switch_screen"
                android:gravity="center"
                android:padding="4dp"
                android:id="@+id/btn_display_1"
                android:text="@string/game_menu_action_display"
                android:textSize="11sp" />

            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/ic_game_menu_btn_selector"
                android:drawablePadding="4dp"
                android:drawableTop="@drawable/ic_axi_mic"
                android:gravity="center"
                android:padding="4dp"
                android:id="@+id/btn_mic"
                android:text="@string/game_menu_action_microphone"
                android:textSize="11sp" />

            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/ic_game_menu_btn_selector"
                android:drawablePadding="4dp"
                android:drawableTop="@drawable/ic_axi_hdr"
                android:gravity="center"
                android:padding="4dp"
                android:id="@+id/btn_hdr"
                android:text="@string/game_menu_action_hdr"
                android:textSize="11sp" />
            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/ic_game_menu_btn_selector"
                android:contentDescription="@string/clipboard_file_pull"
                android:drawablePadding="4dp"
                android:drawableTop="@drawable/ic_axi_clipboard_send"
                android:gravity="center"
                android:padding="4dp"
                android:id="@+id/btn_pull_clipboard_files"
                android:text="@string/clipboard_file_pull_short"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_gamepad_mouse"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_margin="5dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_gamepad_mouse"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/ic_game_menu_btn_selector"
                android:drawablePadding="4dp"
                android:drawableTop="@drawable/ic_axi_joystick"
                android:gravity="center"
                android:padding="4dp"
                android:text="@string/game_menu_action_gamepad_mouse"
                android:textSize="11sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1" />

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1" />

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:text="@string/game_menu_feature_title"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:orientation="vertical">

            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ic_game_menu_btn_selector"
                android:drawableStart="@drawable/ic_axi_touch"
                android:drawablePadding="4dp"
                android:id="@+id/bt_touch_list"
                android:drawableEnd="@drawable/ic_axi_arrow"
                android:gravity="start|center_vertical"
                android:padding="10dp"
                android:text="@string/game_menu_section_mouse_touch"
                android:textSize="11sp" />

            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/ic_game_menu_btn_selector"
                android:drawableStart="@drawable/ic_axi_quick"
                android:drawablePadding="4dp"
                android:drawableEnd="@drawable/ic_axi_arrow"
                android:gravity="start|center_vertical"
                android:padding="10dp"
                android:text="@string/game_menu_section_shortcuts"
                android:id="@+id/bt_quick_list"
                android:textSize="11sp" />

            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/ic_game_menu_btn_selector"
                android:drawableStart="@drawable/ic_axi_game_pad"
                android:drawablePadding="4dp"
                android:drawableEnd="@drawable/ic_axi_arrow"
                android:gravity="start|center_vertical"
                android:padding="10dp"
                android:id="@+id/bt_virtual_view"
                android:text="@string/game_menu_section_virtual_controls"
                android:textSize="11sp" />

            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/ic_game_menu_btn_selector"
                android:drawableStart="@drawable/ic_axi_game_pad_display"
                android:drawablePadding="4dp"
                android:drawableEnd="@drawable/ic_axi_arrow"
                android:gravity="start|center_vertical"
                android:padding="10dp"
                android:id="@+id/bt_display"
                android:text="@string/game_menu_section_display"
                android:textSize="11sp" />

            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/ic_game_menu_btn_selector"
                android:drawableStart="@drawable/ic_axi_game_pad_device"
                android:drawablePadding="4dp"
                android:drawableEnd="@drawable/ic_axi_arrow"
                android:gravity="start|center_vertical"
                android:padding="10dp"
                android:id="@+id/bt_device"
                android:text="@string/game_menu_section_peripherals"
                android:textSize="11sp" />

            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/ic_game_menu_btn_selector"
                android:drawableStart="@drawable/ic_axi_touch_sensitivity"
                android:drawablePadding="4dp"
                android:drawableEnd="@drawable/ic_axi_arrow"
                android:gravity="start|center_vertical"
                android:padding="10dp"
                android:id="@+id/bt_touch_sensitivity"
                android:text="@string/game_menu_section_touch_sensitivity"
                android:textSize="11sp" />

            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/ic_game_menu_btn_selector"
                android:drawableStart="@drawable/ic_axi_other_setting"
                android:drawablePadding="4dp"
                android:drawableEnd="@drawable/ic_axi_arrow"
                android:gravity="start|center_vertical"
                android:padding="10dp"
                android:id="@+id/bt_other_setting"
                android:text="@string/game_menu_section_miscellaneous"
                android:textSize="11sp" />

        </LinearLayout>


    </LinearLayout>
    </ScrollView>

</RelativeLayout>
