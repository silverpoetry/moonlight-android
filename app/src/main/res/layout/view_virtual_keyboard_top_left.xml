<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="5dp">

    <!-- The wrapper keeps a transparent safe inset outside the panel background. -->
    <LinearLayout
        android:id="@+id/lv_right_view"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:background="@drawable/ic_top_view_left_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp"
        tools:ignore="UselessParent">

        <TextView
            android:id="@+id/tx_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_current_button_preview"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tx_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_key_value_preview"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tx_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_coordinates_preview"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tx_zoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keyboard_scale_preview"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/sb_zoom_x"
            style="@style/GameMenuSeekBar"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:progress="50" />

        <LinearLayout
            android:id="@+id/lv_zoom_wh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tx_zoom_w"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_width_scale_preview"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/sb_zoom_w"
                style="@style/GameMenuSeekBar"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:progress="50" />

            <TextView
                android:id="@+id/tx_zoom_h"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/keyboard_height_scale_preview"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/sb_zoom_h"
                style="@style/GameMenuSeekBar"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:progress="50" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <CheckBox
                android:id="@+id/cb_switch_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#8C99E6"
                android:gravity="center"
                android:padding="0dp"
                android:text="@string/keyboard_lock_mode"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cb_round"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#8C99E6"
                android:gravity="center"
                android:padding="0dp"
                android:text="@string/keyboard_square_button"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tx_del"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:text="@string/keyboard_delete"
            android:textColor="#FB4545"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tx_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:text="@string/keyboard_cancel"
            android:textColor="#2EA1FB"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
