<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Keep cloud backup for benign user-authored files, but never move
         device-bound settings, host certificates, or client identity. -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="client.key" />
        <exclude domain="file" path="client.crt" />
        <exclude domain="file" path="uniqueid" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="client.key" />
        <exclude domain="file" path="client.crt" />
        <exclude domain="file" path="uniqueid" />
    </device-transfer>
</data-extraction-rules>
