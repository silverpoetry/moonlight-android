<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:seekbar="http://schemas.moonlight-stream.com/apk/res/seekbar">

    <PreferenceCategory
        android:key="section_video_display"
        android:title="@string/category_video_display_settings">
        <ListPreference
            android:key="stream.video.resolution"
            android:title="@string/title_resolution_list"
            android:summary="@string/summary_resolution_list"
            android:entries="@array/resolution_names"
            android:entryValues="@array/resolution_values"
            android:defaultValue="1920x1080" />
        <ListPreference
            android:key="stream.video.aspect_ratio"
            android:title="@string/title_resolution_aspect_ratio"
            android:summary="@string/summary_resolution_aspect_ratio"
            android:entries="@array/resolution_aspect_ratio_names"
            android:entryValues="@array/resolution_aspect_ratio_values"
            android:defaultValue="16_9" />
        <ListPreference
            android:key="stream.video.frame_rate"
            android:title="@string/title_fps_list"
            android:summary="@string/summary_fps_list"
            android:entries="@array/fps_names"
            android:entryValues="@array/fps_values"
            android:defaultValue="60" />
        <SeekBarPreference
            android:key="stream.video.bitrate_kbps"
            android:title="@string/title_seekbar_bitrate"
            android:summary="@string/summary_seekbar_bitrate"
            android:dialogMessage="@string/summary_seekbar_bitrate"
            android:text="@string/suffix_seekbar_bitrate_mbps"
            android:max="300000"
            seekbar:min="500"
            seekbar:step="500"
            seekbar:keyStep="1000"
            seekbar:divisor="1000" />
        <EditTextPreference
            android:key="editor_video_bitrate_mbps"
            android:title="强制设置视频码率（覆盖上方滑动码率）"
            android:summary="如果滑动调节不够精确，可以手动输入 Mbps。超过滑块范围的值仍会在串流时生效。"
            android:dialogTitle="输入视频码率（Mbps）"
            android:dialogMessage="支持整数或一位小数。"
            android:singleLine="true" />
        <EditTextPreference
            android:key="stream.video.custom_resolution"
            android:title="自定义分辨率"
            android:summary="使用宽x高格式添加自定义分辨率，例如 1920x1080。"
            android:dialogTitle="输入自定义分辨率"
            android:dialogMessage="格式：宽x高"
            android:singleLine="true" />
        <CheckBoxPreference
            android:key="stream.display.portrait"
            android:title="竖屏显示模式"
            android:summary="搭配竖屏自定义分辨率使用，并确保主机显示方向一致。"
            android:defaultValue="false" />
        <ListPreference
            android:key="stream.video.codec"
            android:title="@string/title_video_format"
            android:summary="@string/summary_video_format"
            android:entries="@array/video_format_names"
            android:entryValues="@array/video_format_values"
            android:defaultValue="auto" />
        <ListPreference
            android:key="stream.video.frame_pacing"
            android:title="@string/title_frame_pacing"
            android:summary="@string/summary_frame_pacing"
            android:entries="@array/video_frame_pacing_names"
            android:entryValues="@array/video_frame_pacing_values"
            android:defaultValue="latency" />
        <CheckBoxPreference
            android:key="stream.video.low_latency_decode"
            android:title="优化解码低延迟模式（实验性）"
            android:summary="在部分高通和联发科设备上启用更低延迟的解码路径。"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="stream.video.hdr.enabled"
            android:title="@string/title_enable_hdr"
            android:summary="@string/summary_enable_hdr"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="stream.video.full_range"
            android:title="@string/title_full_range"
            android:summary="@string/summary_full_range"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="stream.video.unlock_frame_rates"
            android:title="@string/title_unlock_fps"
            android:summary="@string/summary_unlock_fps"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="stream.video.reduce_refresh_rate"
            android:title="@string/title_checkbox_reduce_refresh_rate"
            android:summary="@string/summary_checkbox_reduce_refresh_rate"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="stream.display.stretch_video"
            android:title="@string/title_checkbox_stretch_video"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="stream.display.use_cutout_area"
            android:title="填充刘海区域"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="stream.display.automatic_orientation"
            android:title="横竖屏自由切换"
            android:defaultValue="false" />
        <ListPreference
            android:key="stream.display.gravity"
            android:title="画面显示位置"
            android:summary="用于折叠屏、平板或特殊画幅下调整画面对齐方式。"
            android:entries="@array/screen_gravity_list_names"
            android:entryValues="@array/screen_gravity_list_values"
            android:defaultValue="0" />
        <CheckBoxPreference
            android:key="stream.display.external_display"
            android:title="外接显示器模式（实验性）"
            android:summary="串流画面显示在外接显示器，控制和性能信息保留在设备屏幕。"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="section_audio"
        android:title="@string/category_audio_settings">
        <ListPreference
            android:key="stream.audio.channel_layout"
            android:title="@string/title_audio_config_list"
            android:summary="@string/summary_audio_config_list"
            android:entries="@array/audio_config_names"
            android:entryValues="@array/audio_config_values"
            android:defaultValue="2" />
        <CheckBoxPreference
            android:key="stream.audio.effects"
            android:title="@string/title_checkbox_enable_audiofx"
            android:summary="@string/summary_checkbox_enable_audiofx"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="stream.audio.play_on_host"
            android:title="@string/title_checkbox_host_audio"
            android:summary="@string/summary_checkbox_host_audio"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="stream.audio.muted"
            android:title="@string/settings_title_stream_audio_muted"
            android:summary="@string/settings_summary_stream_audio_muted"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="section_touch_mouse"
        android:title="@string/category_touch_mouse_settings">
        <ListPreference
            android:key="input.pointer.mode"
            android:title="触控与鼠标模式"
            android:summary="选择触屏、触控板或鼠标输入的处理方式。多点触控板模式需要主机端支持。"
            android:entries="@array/mouse_mode_names"
            android:entryValues="@array/mouse_mode_values"
            android:defaultValue="0" />
        <IntegerListPreference
            android:key="input.touch.keyboard_gesture_finger_count"
            android:title="@string/settings_title_soft_keyboard_gesture"
            android:summary="@string/settings_summary_soft_keyboard_gesture"
            android:entries="@array/soft_keyboard_gesture_names"
            android:entryValues="@array/soft_keyboard_gesture_values"
            android:defaultValue="0" />
        <CheckBoxPreference
            android:key="input.pointer.local_system_cursor"
            android:title="使用本地系统鼠标光标"
            android:summary="显示 Android 系统光标；这与串流端回传并在本地绘制的远程光标不同。"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="input.pointer.navigation_buttons"
            android:title="@string/title_checkbox_mouse_nav_buttons"
            android:summary="@string/summary_checkbox_mouse_nav_buttons"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="input.pointer.absolute_mouse"
            android:title="@string/title_checkbox_absolute_mouse_mode"
            android:summary="@string/summary_checkbox_absolute_mouse_mode"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="input.touch.force_press.enabled"
            android:title="@string/title_checkbox_barometer_force_press"
            android:summary="@string/summary_checkbox_barometer_force_press"
            android:defaultValue="false" />
        <SeekBarPreference
            android:key="input.touch.force_press.threshold_milli_hpa"
            android:dependency="input.touch.force_press.enabled"
            android:title="@string/title_seekbar_barometer_force_press_threshold"
            android:summary="@string/summary_seekbar_barometer_force_press_threshold"
            android:dialogMessage="@string/summary_seekbar_barometer_force_press_threshold"
            android:defaultValue="180"
            android:max="1000"
            android:text="@string/suffix_barometer_force_press_threshold"
            seekbar:min="50"
            seekbar:step="5"
            seekbar:keyStep="10"
            seekbar:divisor="1000"
            seekbar:decimals="3" />
        <SeekBarPreference
            android:key="input.touch.force_press.minimum_duration_ms"
            android:dependency="input.touch.force_press.enabled"
            android:title="@string/title_seekbar_barometer_force_press_min_duration"
            android:summary="@string/summary_seekbar_barometer_force_press_min_duration"
            android:dialogMessage="@string/summary_seekbar_barometer_force_press_min_duration"
            android:defaultValue="100"
            android:max="500"
            android:text="@string/suffix_barometer_force_press_min_duration"
            seekbar:min="0"
            seekbar:step="10"
            seekbar:keyStep="10" />
        <CheckBoxPreference
            android:key="input.transport.disable_adaptive_throttling"
            android:title="@string/title_checkbox_disable_adaptive_input_throttling"
            android:summary="@string/summary_checkbox_disable_adaptive_input_throttling"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="input.direct_touch.sensitivity_enabled"
            android:title="@string/settings_title_direct_touch_sensitivity"
            android:summary="@string/settings_summary_direct_touch_sensitivity"
            android:defaultValue="false" />
        <SeekBarPreference
            android:key="input.direct_touch.sensitivity_x"
            android:dependency="input.direct_touch.sensitivity_enabled"
            android:title="@string/settings_title_direct_touch_sensitivity_x"
            android:summary="@string/settings_summary_pointer_sensitivity"
            android:dialogMessage="@string/settings_summary_pointer_sensitivity"
            android:text="%"
            android:defaultValue="100"
            android:max="800"
            seekbar:min="10"
            seekbar:step="1" />
        <SeekBarPreference
            android:key="input.direct_touch.sensitivity_y"
            android:dependency="input.direct_touch.sensitivity_enabled"
            android:title="@string/settings_title_direct_touch_sensitivity_y"
            android:summary="@string/settings_summary_pointer_sensitivity"
            android:dialogMessage="@string/settings_summary_pointer_sensitivity"
            android:text="%"
            android:defaultValue="100"
            android:max="800"
            seekbar:min="10"
            seekbar:step="1" />
        <CheckBoxPreference
            android:key="input.direct_touch.global_sensitivity"
            android:dependency="input.direct_touch.sensitivity_enabled"
            android:title="@string/settings_title_direct_touch_global"
            android:summary="@string/settings_summary_direct_touch_global"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="input.direct_touch.recenter_after_rotation"
            android:dependency="input.direct_touch.sensitivity_enabled"
            android:title="@string/settings_title_direct_touch_recenter"
            android:summary="@string/settings_summary_direct_touch_recenter"
            android:defaultValue="true" />
        <SeekBarPreference
            android:key="input.touchpad.pointer_sensitivity_x"
            android:title="@string/settings_title_touchpad_pointer_x"
            android:summary="@string/settings_summary_pointer_sensitivity"
            android:dialogMessage="@string/settings_summary_pointer_sensitivity"
            android:text="%"
            android:defaultValue="100"
            android:max="300"
            seekbar:min="10"
            seekbar:step="1" />
        <SeekBarPreference
            android:key="input.touchpad.pointer_sensitivity_y"
            android:title="@string/settings_title_touchpad_pointer_y"
            android:summary="@string/settings_summary_pointer_sensitivity"
            android:dialogMessage="@string/settings_summary_pointer_sensitivity"
            android:text="%"
            android:defaultValue="100"
            android:max="300"
            seekbar:min="10"
            seekbar:step="1" />
        <SeekBarPreference
            android:key="input.virtual_touchpad.sensitivity_x"
            android:title="@string/settings_title_virtual_touchpad_x"
            android:summary="@string/settings_summary_pointer_sensitivity"
            android:dialogMessage="@string/settings_summary_pointer_sensitivity"
            android:text="%"
            android:defaultValue="100"
            android:max="300"
            seekbar:min="10"
            seekbar:step="1" />
        <SeekBarPreference
            android:key="input.virtual_touchpad.sensitivity_y"
            android:title="@string/settings_title_virtual_touchpad_y"
            android:summary="@string/settings_summary_pointer_sensitivity"
            android:dialogMessage="@string/settings_summary_pointer_sensitivity"
            android:text="%"
            android:defaultValue="100"
            android:max="300"
            seekbar:min="10"
            seekbar:step="1" />
        <SeekBarPreference
            android:key="input.external_touchpad.sensitivity_x"
            android:title="@string/settings_title_external_touchpad_x"
            android:summary="@string/settings_summary_pointer_sensitivity"
            android:dialogMessage="@string/settings_summary_pointer_sensitivity"
            android:text="%"
            android:defaultValue="100"
            android:max="300"
            seekbar:min="10"
            seekbar:step="1" />
        <SeekBarPreference
            android:key="input.external_touchpad.sensitivity_y"
            android:title="@string/settings_title_external_touchpad_y"
            android:summary="@string/settings_summary_pointer_sensitivity"
            android:dialogMessage="@string/settings_summary_pointer_sensitivity"
            android:text="%"
            android:defaultValue="100"
            android:max="300"
            seekbar:min="10"
            seekbar:step="1" />
        <SeekBarPreference
            android:key="input.external_touchpad.scroll_amount"
            android:title="@string/settings_title_external_touchpad_scroll"
            android:summary="@string/settings_summary_scroll_amount"
            android:dialogMessage="@string/settings_summary_scroll_amount"
            android:defaultValue="5"
            android:max="30"
            seekbar:min="1"
            seekbar:step="1" />
        <SeekBarPreference
            android:key="input.mouse.wheel_scroll_amount"
            android:title="@string/settings_title_mouse_wheel_scroll"
            android:summary="@string/settings_summary_scroll_amount"
            android:dialogMessage="@string/settings_summary_scroll_amount"
            android:defaultValue="5"
            android:max="30"
            seekbar:min="1"
            seekbar:step="1" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="section_gamepad"
        android:title="@string/category_gamepad_settings">
        <SeekBarPreference
            android:key="input.controller.stick_deadzone_percent"
            android:title="@string/title_seekbar_deadzone"
            android:summary="@string/summary_seekbar_deadzone"
            android:text="@string/suffix_seekbar_deadzone"
            android:defaultValue="7"
            android:max="50" />
        <CheckBoxPreference
            android:key="input.controller.trigger_deadzone_disabled"
            android:title="禁用默认手柄扳机死区"
            android:summary="让 Moonlight 不再应用默认的 13% 扳机死区；部分设备驱动仍可能自行处理死区。"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="input.controller.multiple_controllers"
            android:title="@string/title_checkbox_multi_controller"
            android:summary="@string/summary_checkbox_multi_controller"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="input.controller.usb_driver.enabled"
            android:title="@string/title_checkbox_xb1_driver"
            android:summary="@string/summary_checkbox_xb1_driver"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="input.controller.usb_driver.claim_all_devices"
            android:dependency="input.controller.usb_driver.enabled"
            android:title="@string/title_checkbox_usb_bind_all"
            android:summary="@string/summary_checkbox_usb_bind_all"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="input.controller.mouse_emulation.enabled"
            android:title="@string/title_checkbox_mouse_emulation"
            android:summary="@string/summary_checkbox_mouse_emulation"
            android:defaultValue="true" />
        <IntegerListPreference
            android:key="input.controller.mouse_emulation.button"
            android:dependency="input.controller.mouse_emulation.enabled"
            android:title="@string/settings_title_controller_menu_shortcut"
            android:summary="@string/settings_summary_controller_menu_shortcut"
            android:entries="@array/controller_menu_shortcut_names"
            android:entryValues="@array/controller_menu_shortcut_values"
            android:defaultValue="0" />
        <ListPreference
            android:key="input.controller.mouse_emulation.scrolling_stick"
            android:dependency="input.controller.mouse_emulation.enabled"
            android:title="@string/title_analog_scrolling"
            android:summary="@string/summary_analog_scrolling"
            android:entries="@array/analog_scrolling_names"
            android:entryValues="@array/analog_scrolling_values"
            android:defaultValue="right" />
        <SeekBarPreference
            android:key="input.controller.mouse_emulation.sensitivity_percent"
            android:dependency="input.controller.mouse_emulation.enabled"
            android:title="@string/settings_title_controller_mouse_sensitivity"
            android:summary="@string/settings_summary_pointer_sensitivity"
            android:dialogMessage="@string/settings_summary_pointer_sensitivity"
            android:text="%"
            android:defaultValue="100"
            android:max="300"
            seekbar:min="10"
            seekbar:step="1" />
        <CheckBoxPreference
            android:key="input.controller.flip_face_buttons"
            android:title="@string/title_checkbox_flip_face_buttons"
            android:summary="@string/summary_checkbox_flip_face_buttons"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="input.controller.touchpad_as_mouse"
            android:title="@string/title_checkbox_gamepad_touchpad_as_mouse"
            android:summary="@string/summary_checkbox_gamepad_touchpad_as_mouse"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="input.controller.motion.enabled"
            android:title="@string/title_checkbox_gamepad_motion_sensors"
            android:summary="@string/summary_checkbox_gamepad_motion_sensors"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="input.controller.motion.fallback_to_device"
            android:title="@string/title_checkbox_gamepad_motion_fallback"
            android:summary="@string/summary_checkbox_gamepad_motion_fallback"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="input.controller.motion.force_gyro"
            android:title="@string/settings_title_force_gyro"
            android:summary="@string/settings_summary_force_gyro"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="input.controller.motion.force_gyro_requires_left_trigger"
            android:dependency="input.controller.motion.force_gyro"
            android:title="@string/settings_title_force_gyro_left_trigger"
            android:summary="@string/settings_summary_force_gyro_left_trigger"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="input.controller.motion.force_gyro_swap_axes"
            android:dependency="input.controller.motion.force_gyro"
            android:title="@string/settings_title_force_gyro_swap_axes"
            android:summary="@string/settings_summary_force_gyro_swap_axes"
            android:defaultValue="true" />
        <SeekBarPreference
            android:key="input.controller.motion.force_gyro_sensitivity_percent"
            android:dependency="input.controller.motion.force_gyro"
            android:title="@string/settings_title_force_gyro_sensitivity"
            android:summary="@string/settings_summary_force_gyro_sensitivity"
            android:dialogMessage="@string/settings_summary_force_gyro_sensitivity"
            android:text="%"
            android:defaultValue="120"
            android:max="200"
            seekbar:min="50"
            seekbar:step="5"
            seekbar:keyStep="5" />
        <CheckBoxPreference
            android:key="input.controller.joycon_compatibility"
            android:title="Switch Joy-Con 兼容模式"
            android:summary="仅在 Joy-Con 无法使用或按键识别异常时开启。"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="input.controller.battery_reporting"
            android:title="启用手柄电池状态报告"
            android:summary="在可用时汇报手柄电池状态；若其他输入偶发卡顿，可尝试关闭。"
            android:defaultValue="true" />
        <CheckBoxPreference
            android:key="input.virtual_gamepad.device_motion"
            android:title="虚拟手柄使用设备陀螺仪"
            android:summary="把手机或平板的运动传感器作为虚拟手柄运动数据。"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="input.controller.rumble.fallback_to_device"
            android:title="@string/title_checkbox_vibrate_fallback"
            android:summary="@string/summary_checkbox_vibrate_fallback"
            android:defaultValue="false" />
        <SeekBarPreference
            android:key="input.controller.rumble.fallback_strength_percent"
            android:dependency="input.controller.rumble.fallback_to_device"
            android:title="@string/title_seekbar_vibrate_fallback_strength"
            android:summary="@string/summary_seekbar_vibrate_fallback_strength"
            android:text="@string/suffix_seekbar_vibrate_fallback_strength"
            android:defaultValue="100"
            android:max="200" />
        <CheckBoxPreference
            android:key="input.controller.rumble.flip_motors"
            android:title="反转左右握把震动"
            android:summary="仅在左右震动与扳机对应关系相反时开启。"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="input.controller.rumble.use_device"
            android:title="强制使用设备震动马达"
            android:summary="忽略手柄自身震动并改用手机或平板的震动马达。"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="input.controller.rumble.force_strong"
            android:title="@string/settings_title_force_strong_vibrations"
            android:summary="@string/settings_summary_force_strong_vibrations"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="input.controller.rumble.stop_pulse"
            android:dependency="input.controller.rumble.force_strong"
            android:title="@string/settings_title_stop_strong_vibration_pulse"
            android:summary="@string/settings_summary_stop_strong_vibration_pulse"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="stream.haptics.audio.enabled"
            android:title="启用音频震动"
            android:summary="将串流音频中的低频、爆炸和撞击转换为震动反馈。"
            android:defaultValue="false" />
        <ListPreference
            android:key="stream.haptics.audio.output_target"
            android:dependency="stream.haptics.audio.enabled"
            android:title="音频震动输出目标"
            android:summary="选择输出到设备或已连接的手柄。"
            android:entries="@array/audio_haptics_output_target_names"
            android:entryValues="@array/audio_haptics_output_target_values"
            android:defaultValue="phone" />
        <SeekBarPreference
            android:key="stream.haptics.audio.strength_percent"
            android:dependency="stream.haptics.audio.enabled"
            android:title="音频震动强度"
            android:summary="调整设备或手柄的音频震动强度。"
            android:text="%"
            android:defaultValue="100"
            android:max="200"
            seekbar:min="25"
            seekbar:step="5"
            seekbar:keyStep="5" />
        <ListPreference
            android:key="stream.haptics.audio.voice_filter"
            android:dependency="stream.haptics.audio.enabled"
            android:title="语音过滤"
            android:summary="降低人声、语音聊天和播报声对震动的触发。"
            android:entries="@array/audio_haptics_voice_filter_names"
            android:entryValues="@array/audio_haptics_voice_filter_values"
            android:defaultValue="off" />
        <CheckBoxPreference
