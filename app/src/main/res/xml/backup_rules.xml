<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Settings, host certificates, and client identity are device-bound.
         Users can move them explicitly through the audited import/export UI. -->
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="client.key" />
    <exclude domain="file" path="client.crt" />
    <exclude domain="file" path="uniqueid" />
</full-backup-content>
